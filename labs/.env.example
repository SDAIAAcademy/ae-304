# Copy to .env and paste your free OpenRouter key (https://openrouter.ai/keys). .env is never committed.
OPENROUTER_API_KEY=
# Optional settings, with their defaults
# AE304_MODEL=google/gemma-4-31b-it:free
# AE304_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
# AE304_BASE_URL=https://openrouter.ai/api/v1
# AE304_CACHE=1        # 0 sends every request to the model
# AE304_QUICK=0        # 1 shrinks repeated timing runs
# AE304_STANDIN=0      # 1 uses the scripted stand-in even with a key
# AE304_MODELS=        # "load" embeds live with the two embedding models (a download of about 470 MB each)
# AE304_PRICE_IN=0     # price per million input tokens, Lab 4.3
# AE304_PRICE_OUT=0    # price per million output tokens, Lab 4.3
